ENVIRONMENT=development

# Supabase (ca-central-1 project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed web origins
ALLOWED_ORIGINS=http://localhost:3000

# Dev/test helpers for curl (not read by the app). Synthetic test clinician only.
SUPABASE_ANON_KEY=
TEST_EMAIL=
TEST_PASSWORD=

# Audit log signing (see core/audit.py for how to generate)
AUDIT_SIGNING_KEY=
AUDIT_KEY_ID=dev-1

# Public keys of other/past signing keys so their rows stay verifiable, as JSON:
# {"dev-1": "<base64 public key>"}. Not secret. Current key is derived automatically.
AUDIT_PUBLIC_KEYS=

# The deployed web app origin. Emails point patients at <it>/sign-in and a fallback link is built on it.
# Dev falls back to http://localhost:3000; elsewhere the endpoint returns 503 until set.
WEB_BASE_URL=

# Optional. Per-patient request budgets for a signed-in patient (in-memory, per instance; 0 = off).
# PATIENT_READS_PER_MINUTE=60
# PATIENT_WRITES_PER_MINUTE=10

# Optional. Comma-separated consent types patients may grant. Empty = any well-formed slug
# (the consent list isn't settled yet).
# CONSENT_TYPES=

# Optional. AI via AWS Bedrock in ca-central-1 (core/ai.py; nothing calls it yet).
# Credentials use boto3's standard chain -- set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY as real
# environment variables (Railway), not here: this file is only read into the app's own settings.
# AWS_REGION is ignored on purpose; the Bedrock region is fixed to ca-central-1.
# BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
# Per-clinic calls per UTC day, in-memory per instance. 0 blocks all AI calls (kill switch).
# AI_DAILY_CALL_CAP_PER_CLINIC=200

# Email via Amazon SES in ca-central-1 (core/mailer.py; docs/api/email.md). Credentials use boto3's
# standard chain -- real environment variables (Railway), as for Bedrock. The region is fixed in code.
# Until SES_FROM_ADDRESS is set, sends are recorded as failed (ses_not_configured).
# SES_FROM_ADDRESS=no-reply@your-verified-domain
# SES_FROM_NAME=
# SES_CONFIGURATION_SET=

# Patient accounts (passwordless email sign-in; docs/api/patient-accounts.md).
# The PUBLIC anon key, the same one the web app has. Without it the sign-in routes answer 503.
# SUPABASE_ANON_KEY=
# The Standard Webhooks secret ("v1,whsec_...") of the Supabase "Send Email" auth hook, which
# stops Supabase sending any mail itself. Without it /auth-hooks/send-email answers 503.
# SEND_EMAIL_HOOK_SECRET=
# How many reverse proxies are in front of the api (Railway: 1). 0 = use the socket's address.
# TRUSTED_PROXY_HOPS=0
# Optional limits (defaults shown): code lifetime, tries per code, wrong surgery dates before a
# lock, how long a signed-in device stays signed in, fallback-link lifetime, sign-in attempts per
# client address per minute.
# PATIENT_CODE_TTL_SECONDS=600
# PATIENT_CODE_MAX_ATTEMPTS=5
# PATIENT_IDENTITY_MAX_ATTEMPTS=3
# PATIENT_SESSION_MAX_AGE_DAYS=30
# PATIENT_FALLBACK_LINK_TTL_HOURS=24
# PATIENT_AUTH_PER_IP_PER_MINUTE=30
