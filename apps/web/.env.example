# Local defaults point at STAGING: the local api (http://localhost:8000, APP_ENV=staging) and the
# staging Supabase project. Production values are set in Vercel (Production only), never here:
# docs/environments.md.
#
# Production (Vercel Production): https://api.clinicallyanchored.ai. Baked in at build time:
# redeploy after changing it. Leave it unset for Vercel Preview until a staging api exists.
NEXT_PUBLIC_API_URL=http://localhost:8000
# The staging project's URL and anon (publishable) key. Never the service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
