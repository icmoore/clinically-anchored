# Local defaults point at STAGING: the local api (http://localhost:8000, APP_ENV=staging) and the
# staging Supabase project. Production values are set in Vercel (Production only), never here:
# docs/environments.md.
#
# Vercel Production: https://api.clinicallyanchored.ai (Production only).
# Vercel Preview (develop at https://staging.clinicallyanchored.ai, and preview URLs):
# https://api-staging.clinicallyanchored.ai, with the staging Supabase values below (Preview only).
# Baked in at build time: redeploy after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000
# The staging project's URL and anon (publishable) key. Never the service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
